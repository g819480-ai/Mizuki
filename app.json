{
  "name": "SCANTY MD BOT",
  "description": "SCANTY MD BOT - WhatsApp bot powered by Baileys and MongoDB Atlas",
  "repository": "https://github.com/g819480-ai/Mizuki",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "mongodb"
  ],
  "env": {
    "MONGO_URI": {
      "description": "MongoDB Atlas connection URI",
      "required": true
    },
    "MONGO_SESSION_ID": {
      "description": "MongoDB WhatsApp authentication session ID",
      "required": true,
      "value": "scanty-md-bot-v2"
    }
  }
}
